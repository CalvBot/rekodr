// Icon 1 is the app icon; 2 and 3 are the tray icons (recording, paused). Drawn by assets/make_icons.py.
1 ICON "../assets/clipback.ico"
2 ICON "../assets/tray-recording.ico"
3 ICON "../assets/tray-paused.ico"

// The first-run setup's begging picture: 15 frames, 5 across and 3 down (setup.cpp).
10 RCDATA "../assets/setup-beg.jpg"

// The free hosts' and Cloudflare's own icons, from their sites, for Share's host rows (library.cpp host_logo).
20 RCDATA "../assets/host-catbox.png"
21 RCDATA "../assets/host-litterbox.png"
22 RCDATA "../assets/host-cloudflare.png"

#include "version.h"

1 VERSIONINFO
FILEVERSION CLIPBACK_VERSION_NUM
PRODUCTVERSION CLIPBACK_VERSION_NUM
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", APP_NAME
      VALUE "FileDescription", APP_NAME " replay buffer"
      VALUE "FileVersion", CLIPBACK_VERSION
      VALUE "ProductVersion", CLIPBACK_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
