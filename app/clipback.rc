// Icon 1 is the app icon; 2 and 3 are the tray icons (recording, paused). Drawn by assets/make_icons.py.
1 ICON "../assets/clipback.ico"
2 ICON "../assets/tray-recording.ico"
3 ICON "../assets/tray-paused.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "clipback"
      VALUE "FileDescription", "clipback replay buffer"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
