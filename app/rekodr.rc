// Icon 1 is the app icon; 2 and 3 are the tray icons (recording, paused).
1 ICON "../assets/icons/rekodr.ico"
2 ICON "../assets/icons/tray-recording.ico"
3 ICON "../assets/icons/tray-paused.ico"

// The first-run setup's begging picture: 15 frames, 5 across and 3 down (setup.cpp).
10 RCDATA "../assets/images/setup-beg.jpg"

// The first-run setup's example clip picture: one frame of a Counter-Strike 2 clip, 400 x 225 (setup.cpp).
11 RCDATA "../assets/images/setup-example.jpg"

// Cloudflare's own icon, from its site, for Share's host rows (library.cpp host_logo).
21 RCDATA "../assets/images/host-cloudflare.png"

// The app's typeface, Onest (fonts/OFL.txt is its licence), read in place by ui_load_fonts.
30 RCDATA "fonts/Onest-Regular.ttf"
31 RCDATA "fonts/Onest-SemiBold.ttf"
32 RCDATA "fonts/Onest-Bold.ttf"

// The sound library (app.h SOUND_LIBRARY, in the same order from SOUND_RES): each event's own sound, then the others
// to pick from. All are made from chime.wav with ffmpeg.
40 RCDATA "../assets/sounds/clip-saved.wav"
41 RCDATA "../assets/sounds/share-ready.wav"
42 RCDATA "../assets/sounds/marker.wav"
43 RCDATA "../assets/sounds/recording-on.wav"
44 RCDATA "../assets/sounds/recording-off.wav"
45 RCDATA "../assets/sounds/session-saved.wav"
46 RCDATA "../assets/sounds/failed.wav"
47 RCDATA "../assets/sounds/chime.wav"
48 RCDATA "../assets/sounds/high.wav"
49 RCDATA "../assets/sounds/low.wav"
50 RCDATA "../assets/sounds/echo.wav"
51 RCDATA "../assets/sounds/soft.wav"
52 RCDATA "../assets/sounds/tick.wav"
53 RCDATA "../assets/sounds/arpeggio.wav"
54 RCDATA "../assets/sounds/chord.wav"
55 RCDATA "../assets/sounds/double.wav"
56 RCDATA "../assets/sounds/reverse.wav"
57 RCDATA "../assets/sounds/shimmer.wav"
58 RCDATA "../assets/sounds/retro.wav"
59 RCDATA "../assets/sounds/flutter.wav"
60 RCDATA "../assets/sounds/deep.wav"

// The release notes What's new shows (ui.cpp news_window).
70 RCDATA "whatsnew.txt"

#include "version.h"

1 VERSIONINFO
FILEVERSION REKODR_VERSION_NUM
PRODUCTVERSION REKODR_VERSION_NUM
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", APP_NAME
      VALUE "FileDescription", APP_NAME " replay buffer"
      VALUE "FileVersion", REKODR_VERSION
      VALUE "ProductVersion", REKODR_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
