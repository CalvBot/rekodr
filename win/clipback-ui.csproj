<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The process must be named clipback*: clipback.exe keeps its own processes' sound out of recordings -->
    <AssemblyName>clipback-ui</AssemblyName>
    <RootNamespace>Clipback</RootNamespace>
    <Product>clipback</Product>
    <Version>0.1.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\assets\clipback.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>

    <!-- Fast startup: a precompiled (ReadyToRun) single exe. Framework-dependent by default like Compress
         for Discord (small, uses the installed .NET 9 Desktop Runtime); build.ps1 -SelfContained bundles the runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- src\Debug: test hooks for screenshots (CLIPBACK_UI_TEST); release builds have none of it -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="src\Debug\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\clipback.ico" LogicalName="clipback.ico" />
  </ItemGroup>

</Project>
